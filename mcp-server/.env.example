# Minecraft MCP SSE Server Configuration

# Server Settings
PORT=3000
BIND_ADDRESS=0.0.0.0  # Use localhost for local-only, 0.0.0.0 for all interfaces

# Security
MCP_API_KEY=your-secure-api-key-here-change-this

# SSL/TLS (optional, for HTTPS)
SSL_CERT_FILE=/path/to/cert.pem
SSL_KEY_FILE=/path/to/key.pem

# Default Minecraft Server (optional)
DEFAULT_MC_HOST=
DEFAULT_MC_PORT=25565

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FILE=/var/log/minecraft-mcp/server.log